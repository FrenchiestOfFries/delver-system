      "path": "lang/pl.json",
      "flags": {}
    }
  ],

  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },

  "manifest": "https://raw.githubusercontent.com/FrenchiestOfFries/delver-system/refs/heads/main/system.json",

  "download": "https://github.com/FrenchiestOfFries/delver-system/releases/download/v0.1.0/delver.zip",

  "grid": {
